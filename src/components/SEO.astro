---
import type { Lang } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  path?: string;
  image?: string;
  type?: 'website' | 'article';
  hasAlternate?: boolean;
}

const {
  title,
  description,
  lang,
  path = '/',
  image = '/og-default.png',
  type = 'website',
  hasAlternate = true,
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const enPath = path === '/' ? '/' : path;
const hePath = path === '/' ? '/he/' : `/he${path}`;
const canonical = site + (lang === 'en' ? enPath : hePath);
const ogImage = image.startsWith('http') ? image : site + image;
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{hasAlternate ? (
  <>
    <link rel="alternate" hreflang="en" href={site + enPath} />
    <link rel="alternate" hreflang="he" href={site + hePath} />
    <link rel="alternate" hreflang="x-default" href={site + enPath} />
  </>
) : (
  <link rel="alternate" hreflang={lang} href={canonical} />
)}

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={lang === 'he' ? 'he_IL' : 'en_US'} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

---
import Base from '../layouts/Base.astro';
import { useTranslations } from '../i18n/utils';
const lang = 'en' as const;
const t = useTranslations(lang);
---
<Base lang={lang} path="/about" title={`${t('about.title')} — ${t('site.title')}`} description={t('about.p1')}>
  <article class="article">
    <span class="mono">{t('nav.about')}</span>
    <h1>{t('about.title')}</h1>
    <div class="prose">
      <p>{t('about.p1')}</p>
      <p>{t('about.p2')}</p>
      <p>{t('about.p3')}</p>
    </div>
  </article>
</Base>

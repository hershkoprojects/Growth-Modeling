---
import Base from '../layouts/Base.astro';
import GrowthLoop from '../components/GrowthLoop.astro';
import { getCollection } from 'astro:content';
import { localePath } from '../i18n/utils';

const lang = 'en' as const;
const posts = (await getCollection('blog', (p) => p.id.startsWith('en/') && !p.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);

const flowLabels = {
  n1: 'Target', n2: 'Growth drivers', n3: 'Assumptions', n4: 'Decisions',
  center1: 'Growth', center2: 'Model',
  driversLabel: 'Core drivers',
  drivers: ['Acquisition', 'Conversion', 'Pricing', 'Retention', 'Revenue'],
};

const strip = ['Target', 'Growth drivers', 'Assumptions', 'Scenarios', 'Decisions'];
const questions = [
  'How many customers do you need to reach your revenue target?',
  'How many leads or users are required to reach that customer target?',
  'What conversion rate is needed at each stage?',
  'What is a realistic CAC for the business?',
  'What level of retention does the model require?',
  'Which assumptions matter most to the plan?',
  'What happens if one of those assumptions is wrong?',
];
---
<Base lang={lang} path="/" title="Modelera, Growth Modeling for Startups" description="Growth modeling for startups, from the initial model to ongoing plan versus actual reviews, scenario analysis and growth decision support.">
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow"><span class="dot"></span><span class="mono">Growth Modeling for Startups</span></span>
        <h1>Know what needs to be true for your startup to <span class="u">grow</span></h1>
        <p class="lead">A growth model connects a business target to what actually needs to happen across acquisition, conversion, pricing, retention and revenue.</p>
        <p style="color:var(--muted);font-size:16px;max-width:58ch;margin:-12px 0 28px">I work with founders to build a growth model around their business. When useful, we continue with ongoing reviews that compare the model with actual performance, test scenarios and support better growth decisions.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={localePath(lang, '/contact')}>Build Your Growth Model</a>
          <a class="btn btn-ghost" href="#services">See How It Works</a>
        </div>
      </div>
      <GrowthLoop labels={flowLabels} />
    </div>
    <div class="flowstrip"><div class="wrap flowstrip-inner">
      {strip.map((s, i) => (<>
        <span class="step">{s}</span>{i < strip.length - 1 && <span class="arr">→</span>}
      </>))}
    </div></div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="sec-head"><span class="mono">The Core Question</span><h2>What needs to be true to reach the target?</h2></div>
      <div class="corebox corebox-support">
        <div>
          <span class="target">Business Target</span>
          <p style="color:var(--muted);margin-bottom:12px">A useful model breaks a business target into questions you can measure, test and update.</p>
          <ul class="qlist">{questions.map((q) => <li>{q}</li>)}</ul>
        </div>
        <aside class="support-note">
          <span class="support-label">Why it matters</span>
          <p><strong>The goal is not just to forecast the outcome.</strong> It is to understand which drivers and assumptions need to hold for that outcome to become possible.</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="block tinted" id="services">
    <div class="wrap">
      <div class="sec-head"><span class="mono">How We Can Work Together</span><h2>Two ways to work with Modelera</h2><p>Start with an initial growth model, or use it as an ongoing decision making tool.</p></div>
      <div class="cards" style="grid-template-columns:repeat(2,1fr)">
        <div class="card">
          <div class="idx">01 · Growth Model Setup</div>
          <h3>Initial Growth Model</h3>
          <p>For founders who want to understand how their business target connects to the underlying growth drivers.</p>
          <ul class="qlist" style="margin-top:18px">
            <li>Define the business target</li>
            <li>Map the growth drivers</li>
            <li>Build the funnel or revenue model</li>
            <li>Define assumptions and relevant benchmarks</li>
            <li>Build scenarios and sensitivity analysis</li>
            <li>Identify the metrics that matter most</li>
          </ul>
          <a class="more" href={localePath(lang,'/contact')}>Build my growth model →</a>
        </div>
        <div class="card">
          <div class="idx">02 · Ongoing Growth Review</div>
          <h3>Growth Model with Ongoing Support</h3>
          <p>For companies that want to use the model as an operating tool, rather than leave it as a one time planning exercise.</p>
          <ul class="qlist" style="margin-top:18px">
            <li>Weekly or monthly review</li>
            <li>Actual versus model</li>
            <li>Variance analysis and assumption updates</li>
            <li>Scenario testing</li>
            <li>Identify growth bottlenecks</li>
            <li>Prioritize growth levers and support decisions</li>
          </ul>
          <a class="more" href={localePath(lang,'/contact')}>Discuss ongoing support →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="sec-head"><span class="mono">The Model Is Only the Starting Point</span><h2>A growth model that is not tested against reality quickly becomes a historical document</h2><p>The real value comes from using the model repeatedly to understand what changed, what is constraining growth and what to do next.</p></div>
      <div class="flowstrip" style="margin-top:0;border:1px solid var(--line);border-radius:16px;overflow:hidden">
        <div class="wrap flowstrip-inner" style="max-width:none">
          {['Plan','Actual','Variance','Scenario','Decision','Updated model'].map((s, i, arr) => (<>
            <span class="step">{s}</span>{i < arr.length - 1 && <span class="arr">→</span>}
          </>))}
        </div>
      </div>
      <div class="corebox corebox-support" style="margin-top:28px">
        <div>
          <span class="target">Example</span>
          <p style="font-size:18px;font-weight:600;margin-bottom:16px">Revenue is 15% below plan.</p>
          <ul class="qlist">
            <li>Traffic is above forecast</li>
            <li>Conversion is below forecast</li>
            <li>Retention is on plan</li>
          </ul>
        </div>
        <aside class="support-note">
          <span class="support-label">What the model tells you</span>
          <p><strong>Acquisition is not the main problem.</strong> Conversion is currently the bigger constraint.</p>
          <p class="support-action"><strong>Decision:</strong> test ways to improve conversion before increasing acquisition spend.</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="block tinted">
    <div class="wrap">
      <div class="sec-head"><span class="mono">When It Is Useful</span><h2>A growth model supports different stages of a startup</h2></div>
      <div class="cards">
        <div class="card moment"><span class="tag">Before launch</span><h3>When there is no real performance data yet</h3><p>The model relies more heavily on assumptions and relevant benchmarks to test whether the target is realistic and what needs to happen along the way.</p></div>
        <div class="card moment"><span class="tag">Fundraising</span><h3>Show how the company gets to the target</h3><p>The model helps explain not only the revenue forecast, but also the growth drivers and assumptions behind it.</p></div>
        <div class="card moment"><span class="tag">After launch</span><h3>Replace assumptions with actual performance</h3><p>This is where the model becomes more valuable. You can compare plan with reality, identify variances, update assumptions and make better decisions.</p></div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="sec-head"><span class="mono">Growth Model ≠ Financial Model</span><h2>A growth model is not a financial model</h2></div>
      <div class="vs">
        <div class="vscard"><span class="vk">Financial model</span><p class="vq">What will revenue, costs and cash flow look like?</p></div>
        <div class="vscard accent"><span class="vk">Growth model</span><p class="vq">What actually needs to happen for that revenue to exist?</p></div>
      </div>
      <p class="vs-note">The model connects customer acquisition, conversion, pricing, retention and other growth drivers to the business target.</p>
    </div>
  </section>

  <section class="block tinted">
    <div class="wrap">
      <div class="sec-head"><span class="mono">Who Is Behind Modelera</span><h2>Built from hands on experience in growth, marketing and strategy</h2></div>
      <div class="about-card">
        <p class="about-bio">Modelera is built from hands on experience working with technology companies and startups. <a href="https://avihershko.com/" target="_blank" rel="noopener noreferrer">Avi Hershko</a> is a business and marketing strategy advisor with more than 20 years of experience, and previously served as VP Growth at Vimeo and Head of Marketing at Fiverr.</p>
        <div class="about-lower">
          <div class="about-note">
            <span class="support-label">Approach</span>
            <p>Business and growth first. The model connects customer acquisition, conversion, pricing, retention and other growth drivers to the business target.</p>
          </div>
          <a class="btn btn-ghost" href={localePath(lang,'/about')}>More about Avi and the Modelera approach</a>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="sec-head"><span class="mono">Insights</span><h2>Growth modeling, assumptions, benchmarks and decision making</h2></div>
      <div class="cards">
        {posts.map((post) => {
          const slug = post.id.replace(/^en\//, '').replace(/\.md$/, '');
          return (
            <a class="card" href={localePath(lang, `/blog/${slug}`)}>
              <div class="idx">{post.data.kind} · {post.data.readMins} min</div>
              <h3>{post.data.title}</h3><p>{post.data.description}</p>
              <span class="more">Read more →</span>
            </a>);
        })}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="finalcta">
        <h2>Do not build a forecast just to show where you want to go</h2>
        <p>Build a model that shows what needs to happen to get there. Then keep testing it against reality.</p>
        <a class="btn btn-primary" href={localePath(lang,'/contact')}>Build Your Growth Model</a>
      </div>
    </div>
  </section>

  <style>
    .corebox-support{align-items:stretch}
    .support-note{align-self:stretch;background:var(--paper-2);border-inline-start:3px solid var(--brand);border-radius:12px;padding:24px 26px;display:flex;flex-direction:column;justify-content:center}
    .support-label{display:block;font-family:var(--mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--brand);margin-bottom:12px}
    .support-note p{font-size:16px;line-height:1.65;color:var(--muted);max-width:42ch}
    .support-note strong{color:var(--ink);font-weight:600}
    .support-action{margin-top:14px;padding-top:14px;border-top:1px solid var(--line)}
    .about-card{border:1px solid var(--line);border-radius:20px;padding:36px;background:#fff}
    .about-bio{font-size:18px;line-height:1.7;max-width:82ch;color:#2a2e38}
    .about-bio a{color:var(--brand);text-decoration:none}
    .about-lower{display:flex;align-items:flex-end;justify-content:space-between;gap:32px;border-top:1px solid var(--line);margin-top:28px;padding-top:24px}
    .about-note{max-width:62ch}
    .about-note p{font-size:16px;line-height:1.65;color:var(--muted)}
    @media(max-width:860px){
      .about-lower{align-items:flex-start;flex-direction:column;gap:20px}
      .support-note{padding:22px}
    }
  </style>
</Base>

---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { useTranslations, localePath } from '../../../i18n/utils';

const lang = 'he' as const;
const t = useTranslations(lang);

const posts = (await getCollection('blog', (p) => p.id.startsWith('he/') && !p.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Base lang={lang} path="/blog" title={`${t('blog.title')} — ${t('site.title')}`} description={t('blog.subtitle')}>
  <section class="block">
    <div class="wrap">
      <div class="sec-head">
        <span class="mono">{t('site.title')}</span>
        <h2>{t('blog.title')}</h2>
        <p>{t('blog.subtitle')}</p>
      </div>
      <div>
        {posts.map((post) => {
          const slug = post.id.replace(/^he\//, '').replace(/\.md$/, '');
          return (
                        <a class="post-row" href={localePath(lang, `/blog/${slug}`)}>
              {post.data.image && <img src={post.data.image} alt={post.data.imageAlt} class="post-row-img" />}
              <div class="post-row-body">
                <span class="k">{post.data.kind} · {post.data.readMins} דק׳</span>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Base>

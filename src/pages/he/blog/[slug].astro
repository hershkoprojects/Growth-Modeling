---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { useTranslations, localePath } from '../../../i18n/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => p.id.startsWith('he/'));
  return posts.map((post) => ({
    params: { slug: post.id.replace(/^he\//, '').replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const toc = headings.filter((heading) => heading.depth === 2);
const lang = 'he' as const;
const t = useTranslations(lang);
const slug = post.id.replace(/^he\//, '').replace(/\.md$/, '');
const date = post.data.pubDate.toLocaleDateString('he-IL', { year: 'numeric', month: 'long', day: 'numeric' });
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://modelera.io';
const canonical = `${site}/he/blog/${slug}`;
const allPosts = await getCollection('blog');
const hasEnglishVersion = allPosts.some((p) => p.id === `en/${slug}.md` || p.id === `en/${slug}`);

const faqBySlug: Record<string, Array<{ question: string; answer: string }>> = {
  'startup-economic-model': [
    {
      question: 'מהו מודל כלכלי לסטארטאפ?',
      answer: 'מודל כלכלי בודק אם העסק יכול לעבוד בצורה כלכלית. הוא מחבר בין עלות רכישת הלקוח, הכנסות, Gross Margin, Retention, LTV ו Payback כדי להבין האם כל לקוח או עסקה מייצרים מספיק ערך.',
    },
    {
      question: 'מה ההבדל בין מודל עסקי למודל כלכלי?',
      answer: 'מודל עסקי מסביר מי הלקוח, איזה ערך הוא מקבל ואיך החברה מרוויחה ממנו. מודל כלכלי בודק אם המבנה הזה עובד במספרים.',
    },
    {
      question: 'מה ההבדל בין מודל כלכלי למודל פיננסי?',
      answer: 'מודל כלכלי מתמקד בכלכלה של מנועי העסק, למשל CAC, LTV ו Unit Economics. מודל פיננסי מתרגם את הפעילות הכוללת לתחזית הכנסות, הוצאות, Cash Flow, Burn ו Runway.',
    },
    {
      question: 'מהו CAC?',
      answer: 'CAC הוא העלות הממוצעת של רכישת לקוח חדש. בחישוב מלא כדאי לכלול את העלויות הרלוונטיות של מנגנון השיווק והמכירות ולא רק את תקציב הפרסום.',
    },
    {
      question: 'מהו LTV?',
      answer: 'LTV הוא הערך הכלכלי שלקוח צפוי לייצר לאורך תקופת הקשר שלו עם החברה. החישוב משתנה לפי סוג העסק וצריך לקחת בחשבון גם Gross Margin ולא רק הכנסות.',
    },
    {
      question: 'מהו יחס LTV:CAC טוב?',
      answer: 'אין יחס אחד שמתאים לכל חברה. בחברות SaaS משתמשים לעיתים ביחס של כ 3:1 כנקודת ייחוס, אך צריך לבחון אותו יחד עם Payback, Gross Margin, שלב החברה וקצב הצמיחה.',
    },
    {
      question: 'אפשר לבנות מודל כלכלי לפני שיש לקוחות?',
      answer: 'כן. בשלב הזה המודל מבוסס בעיקר על הנחות, Benchmarks ותרחישים. לאחר תחילת הפעילות צריך להחליף בהדרגה את ההנחות בנתוני אמת.',
    },
  ],
};

const faqs = faqBySlug[slug] ?? [];
const image = post.data.image ? (post.data.image.startsWith('http') ? post.data.image : `${site}${post.data.image}`) : `${site}/og-default.png`;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: post.data.title,
      description: post.data.description,
      inLanguage: 'he-IL',
      datePublished: post.data.pubDate.toISOString(),
      dateModified: post.data.pubDate.toISOString(),
      image: [image],
      mainEntityOfPage: canonical,
      author: {
        '@type': 'Person',
        name: 'אבי הרשקו',
        url: 'https://avihershko.com/he/',
      },
      publisher: {
        '@type': 'Organization',
        name: 'Modelera',
        url: site,
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Modelera', item: `${site}/he/` },
        { '@type': 'ListItem', position: 2, name: 'בלוג', item: `${site}/he/blog` },
        { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical },
      ],
    },
    ...(faqs.length ? [{
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    }] : []),
  ],
};
---
<Base
  lang={lang}
  path={`/blog/${slug}`}
  title={`${post.data.title} | Modelera`}
  description={post.data.description}
  image={post.data.image}
  type="article"
  hasAlternate={hasEnglishVersion}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  <article class="article">
    <div class="meta">
      <a href={localePath(lang, '/blog')} class="mono">{t('back')}</a>
    </div>
    <span class="mono">{post.data.kind} · {post.data.readMins} דק׳ · {date}</span>
    <h1>{post.data.title}</h1>
    {toc.length > 0 && (
      <nav class="article-toc" aria-label="תוכן עניינים">
        <div class="article-toc-title">תוכן עניינים</div>
        <ol>
          {toc.map((heading) => (
            <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ol>
      </nav>
    )}
    <div class="prose"><Content /></div>
  </article>
</Base>

---
import Base from '../../layouts/Base.astro';
import GrowthLoop from '../../components/GrowthLoop.astro';
import { getCollection } from 'astro:content';
import { useTranslations, localePath } from '../../i18n/utils';

const lang = 'he' as const;
const t = useTranslations(lang);
const arrow = '←';
const posts = (await getCollection('blog', (p) => p.id.startsWith('he/') && !p.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);

const flowLabels = {
  n1: t('flow.n1'), n2: t('flow.n2'), n3: t('flow.n3'), n4: t('flow.n4'),
  center1: t('flow.center1'), center2: t('flow.center2'),
  driversLabel: t('flow.drivers'),
  drivers: [t('flow.d1'), t('flow.d2'), t('flow.d3'), t('flow.d4'), t('flow.d5')],
};
const strip = [t('strip.1'), t('strip.2'), t('strip.3'), t('strip.4'), t('strip.5')];
const questions = [t('core.q1'), t('core.q2'), t('core.q3'), t('core.q4'), t('core.q5'), t('core.q6')];
const funnel = [['af.1v','af.1l'],['af.2v','af.2l'],['af.3v','af.3l'],['af.4v','af.4l'],['af.5v','af.5l'],['af.6v','af.6l']] as const;
const receive = ['rc.i1','rc.i2','rc.i3','rc.i4','rc.i5','rc.i6','rc.i7','rc.i8','rc.i9','rc.i10'] as const;
const deckChain = ['pd.c1','pd.c2','pd.c3','pd.c4','pd.c5','pd.c6'] as const;
const examples = [
  { n: t('ex.1n'), flow: ['Leads','Opportunities','Customers','ACV','ARR'] },
  { n: t('ex.2n'), flow: ['Traffic','Signup','Activation','Paid','Revenue'] },
  { n: t('ex.3n'), flow: ['Traffic','Purchase','Subscription','Retention','Revenue'] },
  { n: t('ex.4n'), flow: ['Supply + Demand','Match','Transaction','Take Rate','Revenue'] },
];
---
<Base lang={lang} path="/" title={`${t('site.title')} — ${t('site.tagline')}`} description={t('meta.home')}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow"><span class="dot"></span><span class="mono">{t('hero.eyebrow')}</span></span>
        <h1>{t('hero.h1a')} <span class="u">{t('hero.h1b')}</span>{t('hero.h1c')}</h1>
        <p class="lead">{t('hero.lead')}</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={localePath(lang, '/contact')}>{t('hero.cta1')}</a>
          <a class="btn btn-ghost" href={localePath(lang, '/blog')}>{t('hero.cta2')}</a>
        </div>
      </div>
      <GrowthLoop labels={flowLabels} />
    </div>
    <div class="flowstrip"><div class="wrap flowstrip-inner">
      {strip.map((s, i) => (<>
        <span class="step">{s}</span>{i < strip.length - 1 && <span class="arr">→</span>}
      </>))}
    </div></div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="sec-head"><span class="mono">{t('core.eyebrow')}</span><h2>{t('core.h2')}</h2></div>
      <div class="corebox">
        <div>
          <span class="target">{t('core.target')}</span>
          <p style="color:var(--muted);margin-bottom:6px">{t('core.p')}</p>
          <ul class="qlist">{questions.map((q) => <li>{q}</li>)}</ul>
        </div>
        <div><p class="keyline">{t('core.key')}</p></div>
      </div>
    </div>
  </section>

  <section class="block tinted">
    <div class="wrap">
      <div class="sec-head"><span class="mono">{t('mo.eyebrow')}</span><h2>{t('mo.h2')}</h2></div>
      <div class="cards">
        <div class="card moment"><span class="tag">{t('mo.1tag')}</span><h3>{t('mo.1h')}</h3><p>{t('mo.1p')}</p><a class="cta" href={localePath(lang,'/contact')}>{t('mo.1cta')} →</a></div>
        <div class="card moment"><span class="tag">{t('mo.2tag')}</span><h3>{t('mo.2h')}</h3><p>{t('mo.2p')}</p><a class="cta" href={localePath(lang,'/contact')}>{t('mo.2cta')} →</a></div>
        <div class="card moment"><span class="tag">{t('mo.3tag')}</span><h3>{t('mo.3h')}</h3><p>{t('mo.3p')}</p><a class="cta" href={localePath(lang,'/contact')}>{t('mo.3cta')} →</a></div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="sec-head"><span class="mono">{t('how.eyebrow')}</span><h2>{t('how.h2')}</h2></div>
      <div class="steps">
        <div class="stepc"><div class="no">01</div><h3>{t('how.1h')}</h3><p>{t('how.1p')}</p></div>
        <div class="stepc"><div class="no">02</div><h3>{t('how.2h')}</h3><p>{t('how.2p')}</p></div>
        <div class="stepc"><div class="no">03</div><h3>{t('how.3h')}</h3><p>{t('how.3p')}</p></div>
        <div class="stepc"><div class="no">04</div><h3>{t('how.4h')}</h3><p>{t('how.4p')}</p></div>
        <div class="stepc"><div class="no">05</div><h3>{t('how.5h')}</h3><p>{t('how.5p')}</p></div>
      </div>
    </div>
  </section>

  <section class="block tinted">
    <div class="wrap">
      <div class="sec-head"><span class="mono">{t('af.eyebrow')}</span><h2>{t('af.h2')}</h2><p>{t('af.p')}</p></div>
      <div class="funnel">
        {funnel.map(([v, l], i) => (<>
          <div class="frow"><span class="fv">{t(v)}</span><span class="fl">{t(l)}</span></div>
          {i < funnel.length - 1 && <div class="fdown">↓</div>}
        </>))}
      </div>
      <div class="scenarios">
        <div class="scenario">{t('sc.1')}</div>
        <div class="scenario">{t('sc.2')}</div>
        <div class="scenario">{t('sc.3')}</div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="sec-head"><span class="mono">{t('rc.eyebrow')}</span><h2>{t('rc.h2')}</h2><p>{t('rc.p')}</p></div>
      <div class="receive">{receive.map((k) => <div class="ri">{t(k)}</div>)}</div>
      <p class="recv-note">{t('rc.note')}</p>
    </div>
  </section>

  <section class="block tinted">
    <div class="wrap">
      <div class="sec-head"><span class="mono">{t('pd.eyebrow')}</span><h2>{t('pd.h2')}</h2><p>{t('pd.p')}</p></div>
      <div class="deck">
        <div>
          <div class="mono" style="margin-bottom:10px">{t('pd.decklbl')}</div>
          <div class="deck-badge">{t('pd.deck')}</div>
        </div>
        <div class="chain">
          {deckChain.map((k, i) => (<>
            <div class="cc">{t(k)}</div>{i < deckChain.length - 1 && <div class="ca">↓</div>}
          </>))}
        </div>
      </div>
      <div style="margin-top:24px"><a class="btn btn-primary" href={localePath(lang,'/contact')}>{t('pd.cta')}</a></div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="sec-head"><span class="mono">{t('vs.eyebrow')}</span><h2>{t('vs.h2')}</h2></div>
      <div class="vs">
        <div class="vscard"><span class="vk">{t('vs.fintitle')}</span><p class="vq">{t('vs.finq')}</p></div>
        <div class="vscard accent"><span class="vk">{t('vs.growtitle')}</span><p class="vq">{t('vs.growq')}</p></div>
      </div>
      <p class="vs-note">{t('vs.note')}</p>
    </div>
  </section>

  <section class="block tinted">
    <div class="wrap">
      <div class="sec-head"><span class="mono">{t('ex.eyebrow')}</span><h2>{t('ex.h2')}</h2></div>
      <div class="examples">
        {examples.map((ex) => (
          <div class="exrow">
            <span class="exname">{ex.n}</span>
            <div class="exflow">
              {ex.flow.map((n, i) => (<>
                <span class="en">{n}</span>{i < ex.flow.length - 1 && <span class="ea">{arrow}</span>}
              </>))}
            </div>
          </div>
        ))}
      </div>
      <p class="ex-note">{t('ex.note')}</p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="sec-head"><span class="mono">{t('ins.eyebrow')}</span><h2>{t('ins.h2')}</h2></div>
      <div class="cards">
        {posts.map((post) => {
          const slug = post.id.replace(/^he\//, '').replace(/\.md$/, '');
          return (
            <a class="card" href={localePath(lang, `/blog/${slug}`)}>
              <div class="idx">{post.data.kind} · {post.data.readMins} דק׳</div>
              <h3>{post.data.title}</h3><p>{post.data.description}</p>
              <span class="more">{t('read')} →</span>
            </a>);
        })}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="finalcta">
        <h2>{t('fin.h2')}</h2><p>{t('fin.p')}</p>
        <a class="btn btn-primary" href={localePath(lang,'/contact')}>{t('fin.cta')}</a>
      </div>
    </div>
  </section>
</Base>

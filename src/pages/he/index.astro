---
import Base from '../../layouts/Base.astro';
import GrowthLoop from '../../components/GrowthLoop.astro';
import { getCollection } from 'astro:content';
import { localePath } from '../../i18n/utils';

const lang = 'he' as const;
const posts = (await getCollection('blog', (p) => p.id.startsWith('he/') && !p.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);

const flowLabels = {
  n1: 'יעד', n2: 'מנועי צמיחה', n3: 'הנחות', n4: 'החלטות',
  center1: 'מודל', center2: 'צמיחה',
  driversLabel: 'מנועים מרכזיים',
  drivers: ['רכישה', 'המרה', 'תמחור', 'שימור', 'הכנסות'],
};

const strip = ['יעד', 'מנועי צמיחה', 'הנחות', 'תרחישים', 'החלטות'];
const questions = [
  'כמה לקוחות צריך כדי להגיע ליעד ההכנסות?',
  'כמה לידים או משתמשים צריך כדי להגיע לכמות הלקוחות הזאת?',
  'איזה שיעור המרה צריך בכל שלב?',
  'מהו CAC סביר עבור העסק?',
  'איזה שיעור שימור נדרש כדי שהמודל יחזיק לאורך זמן?',
  'אילו הנחות הן הקריטיות ביותר להצלחת התוכנית?',
  'מה יקרה אם אחת ההנחות לא תתממש?',
];
---
<Base lang={lang} path="/" title="Modelera, מודל צמיחה לסטארטאפים" description="בניית מודל צמיחה לסטארטאפים וליווי שוטף להשוואת מודל מול ביצועים, בדיקת תרחישים וקבלת החלטות צמיחה.">
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow"><span class="dot"></span><span class="mono">מודל צמיחה לסטארטאפים</span></span>
        <h1>לדעת מה צריך לקרות כדי שהסטארטאפ יוכל <span class="u">לצמוח</span></h1>
        <p class="lead">מודל צמיחה מחבר בין יעד עסקי לבין מה שבאמת צריך לקרות בדרך: רכישה, המרה, תמחור, שימור והכנסות.</p>
        <p style="color:var(--muted);font-size:16px;max-width:58ch;margin:-12px 0 28px">אני עובד עם יזמים ומייסדים על בניית מודל צמיחה שמתאים לעסק שלהם. במידת הצורך אפשר להמשיך גם לתהליך שוטף של השוואת המודל לביצועים בפועל, בדיקת תרחישים וקבלת החלטות.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={localePath(lang, '/contact')}>בואו נבנה את מודל הצמיחה שלכם</a>
          <a class="btn btn-ghost" href="#services">איך זה עובד</a>
        </div>
      </div>
      <GrowthLoop labels={flowLabels} />
    </div>
    <div class="flowstrip"><div class="wrap flowstrip-inner">
      {strip.map((s, i) => (<>
        <span class="step">{s}</span>{i < strip.length - 1 && <span class="arr">→</span>}
      </>))}
    </div></div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="sec-head"><span class="mono">השאלה המרכזית</span><h2>מה חייב להיות נכון כדי להגיע ליעד?</h2></div>
      <div class="corebox corebox-support">
        <div>
          <span class="target">יעד עסקי</span>
          <p style="color:var(--muted);margin-bottom:12px">מודל טוב מפרק יעד עסקי לשאלות שאפשר למדוד, לבדוק ולעדכן.</p>
          <ul class="qlist">{questions.map((q) => <li>{q}</li>)}</ul>
        </div>
        <aside class="support-note">
          <span class="support-label">למה זה חשוב</span>
          <p><strong>המטרה אינה רק לחזות את התוצאה.</strong> המטרה היא להבין אילו מנועים והנחות צריכים לעבוד כדי שהתוצאה תהיה אפשרית.</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="block tinted" id="services">
    <div class="wrap">
      <div class="sec-head"><span class="mono">איך עובדים יחד</span><h2>שתי דרכים לעבוד עם Modelera</h2><p>אפשר להתחיל ממודל ראשוני בלבד, או להפוך אותו לכלי עבודה שוטף לקבלת החלטות.</p></div>
      <div class="cards" style="grid-template-columns:repeat(2,1fr)">
        <div class="card">
          <div class="idx">01 · בניית מודל צמיחה</div>
          <h3>מודל צמיחה ראשוני</h3>
          <p>מתאים ליזמים שרוצים להבין איך היעד העסקי שלהם מתחבר בפועל למנועי הצמיחה.</p>
          <ul class="qlist" style="margin-top:18px">
            <li>הגדרת יעד עסקי</li>
            <li>מיפוי מנועי הצמיחה</li>
            <li>בניית משפך או מודל הכנסות</li>
            <li>הגדרת הנחות ונתוני ייחוס</li>
            <li>בניית תרחישים וניתוח רגישות</li>
            <li>זיהוי המדדים הקריטיים</li>
          </ul>
          <a class="more" href={localePath(lang,'/contact')}>אני רוצה לבנות מודל ←</a>
        </div>
        <div class="card">
          <div class="idx">02 · ליווי שוטף</div>
          <h3>מודל צמיחה עם ליווי שוטף</h3>
          <p>מתאים לחברות שרוצות להשתמש במודל ככלי עבודה קבוע, ולא להשאיר אותו כתוכנית חד פעמית.</p>
          <ul class="qlist" style="margin-top:18px">
            <li>פגישה שבועית או חודשית</li>
            <li>השוואת המודל לביצועים בפועל</li>
            <li>ניתוח פערים ועדכון הנחות</li>
            <li>בדיקת תרחישים</li>
            <li>זיהוי צווארי בקבוק</li>
            <li>תעדוף מנועי צמיחה ותמיכה בהחלטות</li>
          </ul>
          <a class="more" href={localePath(lang,'/contact')}>אני רוצה ליווי שוטף ←</a>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="sec-head"><span class="mono">המודל הוא רק ההתחלה</span><h2>מודל צמיחה שלא מתעדכן מול המציאות הופך מהר מאוד למסמך היסטורי</h2><p>המטרה היא להשתמש במודל באופן שוטף כדי להבין מה השתנה, מה באמת מגביל את הצמיחה ומה כדאי לעשות עכשיו.</p></div>
      <div class="flowstrip" style="margin-top:0;border:1px solid var(--line);border-radius:16px;overflow:hidden">
        <div class="wrap flowstrip-inner" style="max-width:none">
          {['תכנון','ביצוע בפועל','פער','תרחיש','החלטה','מודל מעודכן'].map((s, i, arr) => (<>
            <span class="step">{s}</span>{i < arr.length - 1 && <span class="arr">→</span>}
          </>))}
        </div>
      </div>
      <div class="corebox corebox-support" style="margin-top:28px">
        <div>
          <span class="target">דוגמה</span>
          <p style="font-size:18px;font-weight:600;margin-bottom:16px">ההכנסות נמוכות ב 15% מהתכנון.</p>
          <ul class="qlist">
            <li>היקף התנועה מעל התחזית</li>
            <li>שיעור ההמרה מתחת לתחזית</li>
            <li>שיעור השימור בהתאם לתחזית</li>
          </ul>
        </div>
        <aside class="support-note">
          <span class="support-label">מה המודל אומר לנו</span>
          <p><strong>הבעיה כרגע אינה ברכישת לקוחות.</strong> שיעור ההמרה הוא צוואר הבקבוק המרכזי.</p>
          <p class="support-action"><strong>החלטה:</strong> לבדוק מהלך לשיפור ההמרה לפני הגדלת תקציב השיווק.</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="block tinted">
    <div class="wrap">
      <div class="sec-head"><span class="mono">מתי זה שימושי</span><h2>מודל צמיחה מתאים לשלבים שונים בחיי הסטארטאפ</h2></div>
      <div class="cards">
        <div class="card moment"><span class="tag">לפני השקה</span><h3>כשאין עדיין דאטה אמיתי</h3><p>המודל נשען יותר על הנחות ועל נתוני ייחוס רלוונטיים כדי לבדוק האם היעד העסקי ריאלי ומה חייב לקרות בדרך.</p></div>
        <div class="card moment"><span class="tag">בשלב גיוס</span><h3>להראות איך מגיעים ליעד</h3><p>המודל עוזר להציג לא רק תחזית הכנסות, אלא גם את מנועי הצמיחה וההנחות שמאחוריה.</p></div>
        <div class="card moment"><span class="tag">לאחר ההשקה</span><h3>להחליף הנחות בביצועים אמיתיים</h3><p>כאן הערך עולה. אפשר להשוות את המודל למציאות, לזהות פערים, לעדכן הנחות ולקבל החלטות טובות יותר.</p></div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="sec-head"><span class="mono">מודל צמיחה לעומת מודל פיננסי</span><h2>מודל צמיחה אינו מודל פיננסי</h2></div>
      <div class="vs">
        <div class="vscard"><span class="vk">מודל פיננסי</span><p class="vq">מה יהיו ההכנסות, ההוצאות ותזרים המזומנים?</p></div>
        <div class="vscard accent"><span class="vk">מודל צמיחה</span><p class="vq">מה בפועל צריך לקרות כדי שההכנסות האלה יתקיימו?</p></div>
      </div>
      <p class="vs-note">המודל מחבר בין רכישת לקוחות, המרות, תמחור, שימור ומנועי צמיחה נוספים לבין היעד העסקי.</p>
    </div>
  </section>

  <section class="block tinted">
    <div class="wrap">
      <div class="sec-head"><span class="mono">מי עומד מאחורי Modelera</span><h2>ניסיון מעשי בצמיחה, שיווק ואסטרטגיה</h2></div>
      <div class="about-card">
        <p class="about-bio">Modelera נבנתה מתוך ניסיון מעשי בעבודה עם חברות טכנולוגיה וסטארטאפים. <a href="https://avihershko.com/he/" target="_blank" rel="noopener noreferrer">אבי הרשקו</a> הוא יועץ אסטרטגי עסקי ושיווקי עם יותר מ 20 שנות ניסיון, לשעבר VP Growth ב Vimeo ו Head of Marketing ב Fiverr.</p>
        <div class="about-lower">
          <div class="about-note">
            <span class="support-label">הגישה</span>
            <p>הגישה למודל היא קודם כל עסקית ותפעולית. המודל מחבר בין רכישת לקוחות, המרות, תמחור, שימור ומנועי צמיחה נוספים לבין היעד העסקי.</p>
          </div>
          <a class="btn btn-ghost" href={localePath(lang,'/about')}>עוד על אבי והגישה של Modelera</a>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="sec-head"><span class="mono">תובנות</span><h2>תוכן על מודלי צמיחה, הנחות, נתוני ייחוס וקבלת החלטות</h2></div>
      <div class="cards">
        {posts.map((post) => {
          const slug = post.id.replace(/^he\//, '').replace(/\.md$/, '');
          return (
            <a class="card" href={localePath(lang, `/blog/${slug}`)}>
              {post.data.image && <img src={post.data.image} alt={post.data.imageAlt} class="insight-image" />}
              <div class="idx">{post.data.kind} · {post.data.readMins} דק׳</div>
              <h3>{post.data.title}</h3><p>{post.data.description}</p>
              <span class="more">לקריאה ←</span>
            </a>);
        })}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="finalcta">
        <h2>אל תבנו תחזית רק כדי להראות לאן אתם רוצים להגיע</h2>
        <p>בנו מודל שמראה מה צריך לקרות כדי להגיע לשם. לאחר מכן בדקו אותו מול המציאות.</p>
        <a class="btn btn-primary" href={localePath(lang,'/contact')}>בואו נבנה את מודל הצמיחה שלכם</a>
      </div>
    </div>
  </section>

  <style>
    .corebox-support{align-items:stretch}
    .support-note{align-self:stretch;background:var(--paper-2);border-inline-start:3px solid var(--brand);border-radius:12px;padding:24px 26px;display:flex;flex-direction:column;justify-content:center}
    .support-label{display:block;font-family:var(--mono);font-size:11px;letter-spacing:.02em;color:var(--brand);margin-bottom:12px}
    .support-note p{font-size:16px;line-height:1.65;color:var(--muted);max-width:42ch}
    .support-note strong{color:var(--ink);font-weight:600}
    .support-action{margin-top:14px;padding-top:14px;border-top:1px solid var(--line)}
    .about-card{border:1px solid var(--line);border-radius:20px;padding:36px;background:#fff}
    .about-bio{font-size:18px;line-height:1.7;max-width:82ch;color:#2a2e38}
    .about-bio a{color:var(--brand);text-decoration:none}
    .about-lower{display:flex;align-items:flex-end;justify-content:space-between;gap:32px;border-top:1px solid var(--line);margin-top:28px;padding-top:24px}
    .about-note{max-width:62ch}
    .about-note p{font-size:16px;line-height:1.65;color:var(--muted)}
    .insight-image{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:10px;margin-bottom:18px;display:block}
    @media(max-width:860px){
      .about-lower{align-items:flex-start;flex-direction:column;gap:20px}
      .support-note{padding:22px}
    }
  </style>
</Base>